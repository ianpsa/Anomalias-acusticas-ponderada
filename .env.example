# Optional environment configuration. The UI can save the remote LM connection.
# The server does not load this file automatically: export these variables in your shell.
LM_STUDIO_URL=http://REMOTE_PC_IP:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_KEY=
SERPAPI_KEY=

# Only required when the local Ferris bridge is reachable by another device.
FERRIS_TOKEN=
FERRIS_DEVICE_TOKEN=

# Optional local speech-to-text; directory of an already-downloaded CTranslate2 model.
FERRIS_WHISPER_MODEL=
