# Optional environment configuration. The UI can save the local or LAN connection.
# The server does not load this file automatically: export these variables in your shell.
# Saved data/settings.json takes precedence over these startup defaults.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Identifier assigned with: lms load ... --identifier ferris-gemma
LM_STUDIO_MODEL=ferris-gemma
LM_STUDIO_KEY=
SERPAPI_KEY=

# Only required when the local Ferris bridge is reachable by another device.
FERRIS_TOKEN=
FERRIS_DEVICE_TOKEN=

# Optional USB port. The CLI auto-detects a CP2102 on Linux when this is unset.
FERRIS_SERIAL_PORT=/dev/ttyUSB0

# Optional override; data/whisper/small is discovered automatically after setup_whisper.py.
FERRIS_WHISPER_MODEL=
