# PC do ESP32 (Linux). Sem USB, use apenas compose.yaml.
COMPOSE_FILE=compose.yaml:compose.usb.yaml
FERRIS_PORT=8765
FERRIS_SERIAL_PORT=/dev/ttyUSB0
# No Linux: stat -c '%g' /dev/ttyUSB0
FERRIS_SERIAL_GID=0
# Ajuste se id -u / id -g forem diferentes no seu Linux.
FERRIS_UID=1000
FERRIS_GID=1000

# PC de destino: LM Studio e worker de voz são serviços separados.
LM_STUDIO_URL=http://192.168.15.17:1234/v1
LM_STUDIO_MODEL=google/gemma-4-12b-qat
LM_STUDIO_KEY=
FERRIS_VOICE_URL=http://192.168.15.17:8770/v1
FERRIS_VOICE_PORT=8770
FERRIS_VOICE_BIND=0.0.0.0
# Mesmo valor no worker e na conexão de voz do painel, se usar token.
FERRIS_VOICE_TOKEN=
QWEN_INTRA_THREADS=4
FERRIS_TTS_SENTENCE_CHUNKS=0

SERPAPI_KEY=
FERRIS_TOKEN=
FERRIS_DEVICE_TOKEN=
# O Compose lê este arquivo quando copiado para .env.
# data/settings.json, salvo pelo painel, tem prioridade para URLs/modelo/chaves.
