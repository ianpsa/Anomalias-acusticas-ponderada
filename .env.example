# Copie para .env. O Compose lê esse arquivo sozinho.
# O painel grava data/settings.json, que tem prioridade sobre URLs, modelo e chaves.

# ---- Este PC, o que tem o ESP32 ----
# Sem USB, use só compose.yaml.
COMPOSE_FILE=compose.yaml:compose.usb.yaml
PANEL_PORT=8765
SERIAL_PORT=/dev/ttyUSB0
# stat -c '%g' /dev/ttyUSB0
SERIAL_GID=0
# id -u e id -g
USER_ID=1000
GROUP_ID=1000

# ---- O PC que processa: modelo de linguagem ----
AI_PROCESSOR_URL=http://192.168.15.17:1234/v1
AI_PROCESSOR_MODEL=google/gemma-4-12b-qat
AI_PROCESSOR_KEY=

# ---- O PC que processa: Whisper e voz ----
VOICE_URL=http://192.168.15.17:8770/v1
VOICE_PORT=8770
VOICE_BIND=0.0.0.0
# Threads por sessão ONNX na síntese. Mais não é melhor, meça.
VOICE_THREADS=4
# 1 corta o texto por frase: mais rápido em respostas longas, muda a prosódia.
VOICE_SPLIT_SENTENCES=0

# ---- Chaves e tokens ----
# Vazio libera o acesso. Use o mesmo VOICE_TOKEN nas duas máquinas.
VOICE_TOKEN=
PANEL_TOKEN=
DEVICE_TOKEN=
SEARCH_KEY=
